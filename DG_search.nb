      "   ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"uv", " ", "=", " ", 
          RowBox[{"solveUV", "[", 
           RowBox[{"G", ",", " ", 
            RowBox[{"Total", "[", 
             RowBox[{"ks", " ", 
              RowBox[{"units", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", " ", "\"\<u\>\""}], "]"}], "]"}], " ", 
              RowBox[{"units", "[", 
               RowBox[{"[", 
                RowBox[{
                "All", ",", " ", "\"\<rep\>\"", ",", " ", "\"\<A\>\""}], 
                "]"}], "]"}]}], "]"}], ",", " ", 
            RowBox[{"Total", "[", 
             RowBox[{"ks", " ", 
              RowBox[{"units", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", " ", "\"\<u\>\""}], "]"}], "]"}], " ", 
              RowBox[{"units", "[", 
               RowBox[{"[", 
                RowBox[{
                "All", ",", " ", "\"\<rep\>\"", ",", " ", "\"\<C\>\""}], 
                "]"}], "]"}]}], "]"}]}], "]"}]}], ";", "\n", "    ", 
         RowBox[{"If", "[", 
