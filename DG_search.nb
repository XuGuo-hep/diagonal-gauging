Cell[BoxData["(* All charge allocations of a U(1)R+ spectrum: the N_sign cubic-compatible sign choices (added 3 October 2026). *)\nsignSolutionsAll[items_List] := Module[{states = <|{0, 0} -> {{}}|>, new, ranges, c},   (* items = {{E1, E2}, (N_1, ..., N_q)} per charged complex block, as for signSolutions; returns every sign vector with E_q = 0 for both factors *)\n   Do[new = <||>; ranges = Table[Range[nn, -nn, -2], {nn, it[[2]]}];\n    Do[c = Range[Length[s]] . s;\n     KeyValueMap[Function[{key, paths}, With[{k2 = key + it[[1]] c}, new[k2] = Join[Lookup[new, Key[k2], {}], Append[#, s] & /@ paths]]], states], {s, Tuples[ranges]}];\n    states = new, {it, items}];\n   Lookup[states, Key[{0, 0}], {}]];\nsignCanonical[sv_List] := With[{f = SelectFirst[Flatten[sv], # != 0 &, 0]}, If[f < 0, -sv, sv]];   (* representative of the pair {s, -s}: first nonzero entry positive *)\nsignClassesAll[items_List] := DeleteDuplicates[signCanonical /@ signSolutionsAll[items]];        (* Length = N_sign = (T + f)/2 *)\n\nu1SignItems[sol_] := With[{q = Max[1, sol[\"maxLabel\"]]}, Table[If[b[\"fs\"] == 0 && Total[b[\"alloc\"]] > 0, {b[\"E\"], PadRight[Reverse[b[\"alloc\"]], q]}, Nothing], {b, sol[\"spectrum\"]}]];   (* {E, (N_1, ..., N_q)} of the charged complex blocks, in block order *)\nu1SpectrumString[sol_] := Module[{items = u1SignItems[sol], signs},\n   signs = If[items === {}, {}, signRepresentative[items]];\n   If[signs === None, signs = items[[All, 2]]];\n   u1SpectrumStringSigned[sol, signs]];\nu1SpectrumStringSigned[sol_, signsIn_List] := Module[{q = Max[1, sol[\"maxLabel\"]], blocks = sol[\"spectrum\"], signs = signsIn, parts, zeros, prof},   (* signs: one vector s_j = N_+j - N_-j per charged complex block, in block order *)\n   prof[b_] := PadRight[Reverse[b[\"alloc\"]], q];\n   zeros = ConstantArray[0, q];\n   parts = Table[With[{pr = prof[b], k = b[\"k\"], half = b[\"unit\"] == 1/2},\n      Module[{nq = pr, s, np, nm, nz, mc = Total[pr], str = \"\"},\n       s = If[b[\"fs\"] == 0 && mc > 0, signs[[1]], nq];\n       If[b[\"fs\"] == 0 && mc > 0, signs = Rest[signs]];\n       np = (nq + s)/2; nm = (nq - s)/2;\n       nz = If[half, k - 2 mc, k - mc];\n       If[half && nz > 0, str = ToString[nz] <> \"/2 \" <> b[\"rep\"] <> \"_(\" <> StringRiffle[ToString /@ Join[zeros, {1}, zeros], \",\"] <> \")\" <> If[mc > 0, \" + \", \"\"]];\n       If[! half || mc > 0, str = str <> ToString[If[half, mc, k]] <> \" \" <> b[\"rep\"] <> \"_(\" <> StringRiffle[ToString /@ Join[Reverse[np], {If[half, 0, nz]}, nm], \",\"] <> \")\"];\n       str]], {b, blocks}];\n   StringRiffle[Select[parts, # =!= \"\" &], \" + \"]];\n\nsignAllocations[sol_Association] := Module[{items, cls, rep},                          (* all cubic-compatible charge allocations of a U(1)R+ spectrum, modulo the overall reversal *)\n   If[sol[\"gauging\"] =!= \"U1\", Return[<|\"gauging\" -> sol[\"gauging\"], \"nsign\" -> 1, \"allocations\" -> {{{}, spectrumString[sol]}}, \"note\" -> \"Sp(1)R+ spectra carry no charge signs (N_sign = 1).\"|>]];\n   items = u1SignItems[sol];\n   cls = If[items === {}, {{}}, signClassesAll[items]];\n   rep = If[items === {}, None, signRepresentative[items]];                       (* the choice displayed in the tables is listed first, with its own signs *)\n   If[rep =!= None && MemberQ[cls, signCanonical[rep]], cls = Prepend[DeleteCases[cls, signCanonical[rep]], rep]];\n   <|\"gauging\" -> \"U1\", \"nsign\" -> Length[cls], \"nsignStored\" -> Lookup[sol, \"nsign\", Length[cls]], \"items\" -> items,\n    \"allocations\" -> Table[{sv, u1SpectrumStringSigned[sol, sv]}, {sv, cls}]|>];\nsignAllocationGrid[sol_Association] := Module[{sa = signAllocations[sol], rows},\n   rows = MapIndexed[{First[#2], #1[[2]]} &, sa[\"allocations\"]];\n   Column[{Row[{\"N_sign = \", sa[\"nsign\"], If[KeyExistsQ[sa, \"nsignStored\"] && sa[\"nsignStored\"] != sa[\"nsign\"], \"  (stored value \" <> ToString[sa[\"nsignStored\"]] <> \": MISMATCH)\", \"\"]}],\n     Grid[Prepend[rows, {\"#\", \"charge allocation (one of the N_sign sign choices, up to the overall reversal)\"}], Frame -> All, Alignment -> Left]}]];"], "Input",
 InitializationCell->True,
 CellTags->"DGEngineDefinition"],
