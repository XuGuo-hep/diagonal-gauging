     RowBox[{"OptionsPattern", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<verbose\>\"", " ", "->", " ", "False"}], "}"}], "]"}]}], 
    "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "G", ",", " ", "nV", ",", " ", "nH", ",", " ", "units", ",", " ", 
