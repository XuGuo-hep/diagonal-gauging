            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"ks", "[", 
                RowBox[{"[", "i", "]"}], "]"}], " ", ">", " ", "0"}], ",", 
              " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"units", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "[", "\"\<rep\>\"", "]"}], 
                ",", " ", 
                RowBox[{"ks", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
                RowBox[{"Floor", "[", 
                 RowBox[{
                  RowBox[{"ks", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], " ", 
                  RowBox[{
                   RowBox[{"units", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "[", "\"\<u\>\"", "]"}]}],
                  "]"}]}], "}"}], ",", " ", "Nothing"}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"i", ",", " ", 
              RowBox[{"Length", "[", "units", "]"}]}], "}"}]}], "]"}]}], ";", 
         "\n", "    ", 
         RowBox[{"L", " ", "=", " ", 
          RowBox[{"LCM", " ", "@@", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"Denominator", "[", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "[", "\"\<A\>\"", "]"}], 
               "]"}], " ", "&"}], " ", "/@", " ", "irr"}], ")"}]}]}], ";", 
         "\n", "    ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"admissible", " ", "targets", " ", "of", " ", "pre"}], 
             "-", 
             RowBox[{"filter", " ", "1"}]}], ":", " ", 
