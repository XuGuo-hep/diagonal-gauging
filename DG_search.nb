       ",", " ", "v", ",", " ", "irr", ",", " ", "L", ",", " ", "adjA", ",", 
       " ", "lam", ",", " ", "S2max", ",", " ", "S4max", ",", " ", "K1", ",", 
       " ", "KK", ",", " ", "targets", ",", " ", "real", ",", " ", "st", ",", 
       " ", "new", ",", " ", "key", ",", " ", "cirr", ",", " ", "rirr", ",", 
       " ", "order", ",", " ", "p1", ",", " ", "p2", ",", "\n", "    ", 
       "copts", ",", " ", "nc", ",", " ", "lastBy", ",", " ", "lastKeys", ",",
        " ", "remS2", ",", " ", "compok", ",", " ", "crec", ",", " ", 
       "leafIns", ",", " ", "realidx", ",", " ", "compidx", ",", " ", "small",
        ",", " ", "big", ",", " ", "cnt", ",", " ", "cntE", ",", " ", "tS2", 
       ",", " ", "rS2", ",", " ", "admS2", ",", " ", "nextAdm", ",", " ", 
       "admPairs", ",", " ", 
       RowBox[{"t0", " ", "=", " ", 
        RowBox[{"AbsoluteTime", "[", "]"}]}], ",", " ", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "2"}], ",", " ", 
          RowBox[{"-", "2"}]}], "}"}]}], ",", " ", "At", ",", " ", "orders", 
       ",", " ", "cls", ",", " ", "aByS2", ",", " ", "bByS2", ",", " ", 
       "tByS2", ",", " ", "dtargets"}], "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"nH", " ", "=", " ", 
       RowBox[{
        RowBox[{"groupDimension", "[", 
         RowBox[{"type", ",", " ", "n"}], "]"}], " ", "+", " ", "245"}]}], 
      ";", " ", 
      RowBox[{"nV", " ", "=", " ", 
       RowBox[{"nH", " ", "-", " ", "244"}]}], ";", "\n", "   ", 
      RowBox[{"G", " ", "=", " ", 
       RowBox[{"groupData", "[", 
        RowBox[{"type", ",", " ", "n", ",", " ", "nH"}], "]"}]}], ";", " ", 
      RowBox[{"adjA", " ", "=", " ", 
       RowBox[{
        RowBox[{"G", "[", "\"\<adj\>\"", "]"}], "[", "\"\<A\>\"", "]"}]}], 
      ";", " ", 
      RowBox[{"lam", " ", "=", " ", 
       RowBox[{"G", "[", "\"\<lambda\>\"", "]"}]}], ";", "\n", "   ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"units", ",", " ", "specs"}], "}"}], " ", "=", " ", 
       RowBox[{"Lookup", "[", 
        RowBox[{
         RowBox[{"nonabelianSpectra", "[", "G", "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<units\>\"", ",", " ", "\"\<spectra\>\""}], "}"}]}], 
        "]"}]}], ";", "\n", "   ", 
      RowBox[{"S2max", " ", "=", " ", 
       RowBox[{
        RowBox[{"qmax", "^", "2"}], " ", "nH"}]}], ";", " ", 
      RowBox[{"S4max", " ", "=", " ", 
       RowBox[{
        RowBox[{"qmax", "^", "4"}], " ", "nH"}]}], ";", "\n", "   ", 
      RowBox[{"K1", " ", "=", " ", 
       RowBox[{"S2max", " ", "+", " ", "1"}]}], ";", " ", 
      RowBox[{"KK", " ", "=", " ", 
       RowBox[{"K1", " ", 
        RowBox[{"(", 
         RowBox[{"S4max", " ", "+", " ", "1"}], ")"}]}]}], ";", "\n", "   ", 
      RowBox[{"dtargets", " ", "=", " ", 
