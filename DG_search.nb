                 RowBox[{"t", "[", "\"\<S2\>\"", "]"}], " ", "+", " ", 
                 RowBox[{"K1", " ", 
                  RowBox[{"t", "[", "\"\<S4\>\"", "]"}]}]}]}], ";", " ", 
               RowBox[{
                RowBox[{"targets", "[", "key", "]"}], " ", "=", " ", 
                RowBox[{"Append", "[", 
                 RowBox[{
                  RowBox[{"Lookup", "[", 
                   RowBox[{"targets", ",", " ", "key", ",", " ", 
                    RowBox[{"{", "}"}]}], "]"}], ",", " ", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"L", " ", "At"}], ",", " ", 
                    RowBox[{"rs", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
                    RowBox[{"rs", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}]}]}], ",",
               " ", 
              RowBox[{"{", 
               RowBox[{"rs", ",", " ", "orders"}], "}"}]}], "]"}]}], ",", 
           "\n", "     ", 
           RowBox[{"{", 
            RowBox[{"t", ",", " ", "dtargets"}], "}"}]}], "]"}], ";", "\n", 
         "    ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "targets", "]"}], " ", "==", " ", "0"}], 
           ",", " ", 
           RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\n", "    ", 
         RowBox[{"cirr", " ", "=", " ", 
          RowBox[{"Select", "[", 
           RowBox[{"irr", ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "[", "\"\<fs\>\"", "]"}], " ",
               "==", " ", "0"}], " ", "&"}]}], "]"}]}], ";", " ", 
         RowBox[{"rirr", " ", "=", " ", 
          RowBox[{"Select", "[", 
           RowBox[{"irr", ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "[", "\"\<fs\>\"", "]"}], " ",
               "!=", " ", "0"}], " ", "&"}]}], "]"}]}], ";", "\n", "    ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"cirr", " ", "===", " ", 
            RowBox[{"{", "}"}]}], ",", "\n", "     ", 
           RowBox[{
            RowBox[{"order", " ", "=", " ", 
             RowBox[{"SortBy", "[", 
              RowBox[{"irr", ",", " ", 
               RowBox[{
                RowBox[{"-", 
                 RowBox[{"Binomial", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "3", "]"}], "]"}], " ", "+", " ", "qmax"}], 
                   ",", " ", "qmax"}], "]"}]}], " ", "&"}]}], "]"}]}], ";", 
            " ", 
            RowBox[{"p1", " ", "=", " ", "1"}], ";", " ", 
            RowBox[{"p2", " ", "=", " ", "1"}], ";", " ", 
            RowBox[{"rirr", " ", "=", " ", 
             RowBox[{"{", "}"}]}], ";", " ", 
            RowBox[{"cirr", " ", "=", " ", 
             RowBox[{"{", "}"}]}], ";", "\n", "     ", 
            RowBox[{"Do", "[", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"p1", " ", "<=", " ", "p2"}], ",", " ", 
                RowBox[{
                 RowBox[{"AppendTo", "[", 
