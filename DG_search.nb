           RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\n", "    ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"u", ",", " ", "v"}], "}"}], " ", "=", " ", "uv"}], ";", 
