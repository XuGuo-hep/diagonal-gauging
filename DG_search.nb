             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Length", "[", "block", "]"}], " ", "==", " ", "2"}], 
               ",", "\n", "    ", 
               RowBox[{
                RowBox[{"counts", " ", "=", " ", 
                 RowBox[{"block", "[", 
                  RowBox[{"[", "2", "]"}], "]"}]}], ";", "\n", "    ", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"!", " ", 
                    RowBox[{"ListQ", "[", "counts", "]"}]}], " ", "||", " ", 
                   RowBox[{"!", " ", 
                    RowBox[{"OddQ", "[", 
                    RowBox[{"Length", "[", "counts", "]"}], "]"}]}], " ", "||",
                    "\n", "       ", 
                   RowBox[{"!", " ", 
                    RowBox[{"AllTrue", "[", 
                    RowBox[{"counts", ",", " ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"IntegerQ", "[", "#", "]"}], " ", "&&", " ", 
                    RowBox[{"#", " ", ">=", " ", "0"}]}], " ", "&"}]}], 
                    "]"}]}]}], ",", "\n", "     ", 
                  RowBox[{"DGTableStop", "[", 
                   RowBox[{"DGTableFailure", "[", 
                    RowBox[{"\"\<DGCheckU1\>\"", ",", " ", 
                    RowBox[{"\"\<Block \>\"", " ", "<>", " ", 
                    RowBox[{"ToString", "[", "j", "]"}], " ", "<>", "\n", 
                    "       ", 
                    "\"\< needs an odd-length list of nonnegative integer \
counts in the order +Q, ..., 0, ..., -Q. Do not include an outer \
multiplicity.\>\""}]}], "]"}], "]"}]}], "]"}], ";", "\n", "    ", 
                RowBox[{"q", " ", "=", " ", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"Length", "[", "counts", "]"}], " ", "-", " ", 
                    "1"}], ")"}], "/", "2"}]}], ";", "\n", "    ", 
                RowBox[{"AppendTo", "[", 
                 RowBox[{"converted", ",", " ", 
                  RowBox[{"{", 
                   RowBox[{"rep", ",", " ", 
                    RowBox[{"Flatten", "[", 
                    RowBox[{"MapThread", "[", 
                    RowBox[{"ConstantArray", ",", "\n", "       ", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Range", "[", 
                    RowBox[{"q", ",", " ", 
                    RowBox[{"-", "q"}], ",", " ", 
                    RowBox[{"-", "1"}]}], "]"}], ",", " ", "counts"}], 
                    "}"}]}], "]"}], "]"}]}], "}"}]}], "]"}]}], ",", "\n", 
               "    ", 
               RowBox[{
                RowBox[{"k", " ", "=", " ", 
                 RowBox[{"block", "[", 
                  RowBox[{"[", "3", "]"}], "]"}]}], ";", "\n", "    ", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"block", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], " ", "=!=", " ", 
                    "\"\<half\>\""}], " ", "||", " ", 
                   RowBox[{"!", " ", 
                    RowBox[{"IntegerQ", "[", "k", "]"}]}], " ", "||", " ", 
                   RowBox[{"k", " ", "<", " ", "0"}]}], ",", "\n", "     ", 
                  RowBox[{"DGTableStop", "[", 
                   RowBox[{"DGTableFailure", "[", 
                    RowBox[{"\"\<DGCheckU1\>\"", ",", " ", 
                    RowBox[{"\"\<Block \>\"", " ", "<>", " ", 
                    RowBox[{"ToString", "[", "j", "]"}], " ", "<>", "\n", 
                    "       ", 
                    "\"\< must use {rep, \\\"half\\\", k}, where k is a \
nonnegative integer counting neutral half-hypermultiplets.\>\""}]}], "]"}], 
                   "]"}]}], "]"}], ";", "\n", "    ", 
                RowBox[{"AppendTo", "[", 
                 RowBox[{"converted", ",", " ", 
                  RowBox[{"{", 
                   RowBox[{"rep", ",", " ", "\"\<half\>\"", ",", " ", 
                    RowBox[{"ConstantArray", "[", 
                    RowBox[{"0", ",", " ", "k"}], "]"}]}], "}"}]}], "]"}]}]}],
               "]"}]}], ",", "\n", "   ", 
            RowBox[{"{", 
             RowBox[{"j", ",", " ", 
