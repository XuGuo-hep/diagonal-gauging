\"A5\\\", \\\"D6\\\"}.\>\""}], "]"}], "]"}]}], "]"}], ";", "\n", "  ", 
          RowBox[{"Do", "[", "\n", "   ", 
           RowBox[{
            RowBox[{
             RowBox[{"block", " ", "=", " ", 
              RowBox[{"blocks", "[", 
