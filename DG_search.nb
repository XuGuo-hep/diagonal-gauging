 CellTags->"DGReaderDefinition",
 CellLabel->
  "In[119]:=",ExpressionUUID->"d296cc74-1b69-4bde-a3e7-9780bfd553d3"],
Cell[BoxData["(* Reader interface, part 2: all charge allocations of one spectrum (the N_sign sign choices). Added 3 October 2026. *)\nClearAll[DGSigns, DGSignsU1, DGSignsSpectrumU1];\nDGSigns::usage = \"DGSigns[result, i] lists all charge allocations of row i of DGTable[result]; DGSigns[spectrum] does the same for one spectrum of result[\\\"spectra\\\"].\";\nDGSigns[result_Association, i_Integer] := Module[{specs},\n  If[! KeyExistsQ[result, \"spectra\"], Print[\"Use DGSigns[result, i] with a DGScan result.\"]; Return[$Failed]];\n  specs = result[\"spectra\"];\n  If[i < 1 || i > Length[specs], Print[\"Row \" <> ToString[i] <> \" does not exist: DGTable[result] has \" <> ToString[Length[specs]] <> \" rows.\"]; Return[$Failed]];\n  DGSigns[specs[[i]]]];\nDGSigns[spec_Association] /; KeyExistsQ[spec, \"spectrum\"] := Module[{sa, rows, head, label},\n  sa = signAllocations[spec];\n  label = Lookup[spec, \"group\", Lookup[spec, \"groups\", \"\"]];\n  If[spec[\"gauging\"] =!= \"U1\", Print[label <> \": \" <> sa[\"note\"]]; Return[DGTable[{spec}]]];\n  Print[Row[Join[{label}, If[KeyExistsQ[spec, \"b1\"], {\": b1 = \", spec[\"b1\"]}, {}], If[KeyExistsQ[spec, \"b2\"], {\", b2 = \", spec[\"b2\"]}, {}], If[KeyExistsQ[spec, \"bR\"], {\", bR+ = \", spec[\"bR\"]}, {}],\n     {\"; N_sign = \", sa[\"nsign\"], If[sa[\"nsign\"] != sa[\"nsignStored\"], \" (the stored value \" <> ToString[sa[\"nsignStored\"]] <> \" differs!)\", \"\"], If[sa[\"nsign\"] == 0, \" -- no choice of signs cancels the cubic anomaly\", \"\"]}]]];\n  head = {\"#\", \"Charge allocation (one of the N_sign choices of signs, up to the overall reversal)\", \"s_j = N_+j - N_-j per charged complex block\"};\n  rows = MapIndexed[{First[#2], #1[[2]], #1[[1]]} &, sa[\"allocations\"]];\n  Grid[Prepend[rows, head], Frame -> All, Alignment -> Left, Spacings -> {1, .7}]];\nDGSigns[___] := (Print[\"Use DGSigns[result, i] (row i of DGTable[result]), DGSigns[spectrum] or DGSignsU1[groups, blocks].\"]; $Failed);\n\n(* A spectrum entered in the table notation of Section 3 (the signs of the entered charges are irrelevant here: only N_+j + N_-j matters). *)\nDGSignsSpectrumU1[groups_List, blocks_List] :=\n Catch[Module[{gs, nf, nH, dicts, repInfo, specBlocks = {}, block, rep, names, counts, Q, nj, info, qmax = 0, fsOf, name},\n  If[! DGTableReadyQ[], DGTableStop[DGTableFailure[\"DGSignsU1\", \"Evaluate the initialization cells first.\"]]];\n  gs = DGGroups[groups]; If[gs === $Failed, DGTableStop[$Failed]];\n  nf = Length[gs];\n  If[blocks === {}, DGTableStop[DGTableFailure[\"DGSignsU1\", \"Supply at least one matter block.\"]]];\n  nH = Total[(groupDimension @@ #) & /@ gs] + dimGplus[\"U1\"] + 244;\n  dicts = (groupData[#[[1]], #[[2]], nH] &) /@ gs;\n  If[! DGTableNamesOKQ[\"U1\", gs, First /@ blocks, \"DGSignsU1\"], DGTableStop[$Failed]];\n  repInfo[nm_, i_] := If[nm === \"1\", <|\"dim\" -> 1, \"E\" -> 0, \"fs\" -> 1|>, SelectFirst[dicts[[i]][\"reps\"], #[\"name\"] === nm &]];\n  fsOf[inf_] := If[nf == 1, inf[[1]][\"fs\"], If[inf[[1]][\"fs\"] == 0 || inf[[2]][\"fs\"] == 0, 0, inf[[1]][\"fs\"] inf[[2]][\"fs\"]]];\n  Do[block = blocks[[j]];\n   If[! ListQ[block] || ! MemberQ[{2, 3}, Length[block]], DGTableStop[DGTableFailure[\"DGSignsU1\", \"Block \" <> ToString[j] <> \" must be {rep, {N_+Q, ..., N_0, ..., N_-Q}} or {rep, \\\"half\\\", k}.\"]]];\n   rep = block[[1]];\n   If[! DGTableRepShapeQ[rep, nf], DGTableStop[DGTableFailure[\"DGSignsU1\", \"Block \" <> ToString[j] <> If[nf == 1, \": the representation must be a name such as \\\"6\\\".\", \": the representation must be a pair such as {\\\"6\\\", \\\"1\\\"}.\"]]]];\n   names = If[nf == 1, {rep}, rep]; info = Table[repInfo[names[[i]], i], {i, nf}];\n   name = If[nf == 1, rep, \"(\" <> rep[[1]] <> \",\" <> rep[[2]] <> \")\"];\n   If[Length[block] == 2,\n    counts = block[[2]];\n    If[! ListQ[counts] || ! OddQ[Length[counts]] || ! AllTrue[counts, IntegerQ[#] && # >= 0 &], DGTableStop[DGTableFailure[\"DGSignsU1\", \"Block \" <> ToString[j] <> \": the charge tuple must be a list of 2Q+1 nonnegative integers {N_+Q, ..., N_0, ..., N_-Q}.\"]]];\n    Q = (Length[counts] - 1)/2;\n    nj = Table[counts[[Q + 1 - jj]] + counts[[Q + 1 + jj]], {jj, 1, Q}];\n    qmax = Max[qmax, Max[Prepend[Pick[Range[Q], Positive[nj]], 0]]];\n    AppendTo[specBlocks, <|\"rep\" -> name, \"k\" -> Total[counts], \"unit\" -> 1, \"fs\" -> fsOf[info], \"dim\" -> Times @@ (#[\"dim\"] & /@ info),\n      \"E\" -> If[nf == 1, {info[[1]][\"E\"], 0}, {info[[2]][\"dim\"] info[[1]][\"E\"], info[[1]][\"dim\"] info[[2]][\"E\"]}], \"alloc\" -> Reverse[nj]|>],\n    If[block[[2]] =!= \"half\" || ! IntegerQ[block[[3]]] || block[[3]] < 0, DGTableStop[DGTableFailure[\"DGSignsU1\", \"Block \" <> ToString[j] <> \" must be {rep, \\\"half\\\", k} for k neutral half-hypermultiplets.\"]]];\n    AppendTo[specBlocks, <|\"rep\" -> name, \"k\" -> block[[3]], \"unit\" -> 1/2, \"fs\" -> fsOf[info], \"dim\" -> Times @@ (#[\"dim\"] & /@ info),\n      \"E\" -> If[nf == 1, {info[[1]][\"E\"], 0}, {info[[2]][\"dim\"] info[[1]][\"E\"], info[[1]][\"dim\"] info[[2]][\"E\"]}], \"alloc\" -> {}|>]],\n   {j, Length[blocks]}];\n  <|\"gauging\" -> \"U1\", \"group\" -> StringRiffle[(#[[1]] <> ToString[#[[2]]]) & /@ gs, \"x\"], \"spectrum\" -> specBlocks, \"maxLabel\" -> qmax, \"labels\" -> Range[Max[qmax, 1], 1, -1]|>\n ], DGTableInputFailureTag];\nDGSignsU1::usage = \"DGSignsU1[groups, blocks] lists all charge allocations (cubic-compatible sign choices, up to the overall reversal) of a U(1) spectrum entered in the table notation of Section 3.\";\nDGSignsU1[groups_List, blocks_List] := With[{spec = DGSignsSpectrumU1[groups, blocks]}, If[AssociationQ[spec], DGSigns[spec], spec]];\nDGSignsU1[___] := DGTableFailure[\"DGSignsU1\", \"Use DGSignsU1[groups, blocks], with both arguments lists.\"];"], "Input",
 InitializationCell->True,
 CellTags->"DGReaderDefinition"],
Cell[BoxData["(* Reader panels. Searches and sign enumeration run only from queued buttons. *)\nClearAll[DGPanelReadyQ, DGPanelGroupLabel, DGPanelGroupChoices, DGPanelDefaults,\n  DGPanelMaximumQ, DGPanelScan, DGPanelSignData, DGPanelAllocationView, DGPanelSpectrumText,\n  DGPanelSpectrumGrid, DGReaderPanel];\n\nDGPanelReadyQ[] := TrueQ[$DGReady] && Length[DownValues[oneFactorScan]] > 0 &&\n  Length[DownValues[twoFactorScan]] > 0 && Length[DownValues[signAllocations]] > 0;\nDGPanelGroupLabel[{t_String, n_Integer}] := If[MemberQ[{\"E\", \"F\", \"G\"}, t], t <> ToString[n], t <> ToString[n] <> \"  (\" <>\n  Switch[t, \"A\", \"SU(\" <> ToString[n + 1] <> \")\",\n    \"B\", \"Spin(\" <> ToString[2 n + 1] <> \")\",\n    \"C\", \"Sp(\" <> ToString[n] <> \")\",\n    \"D\", \"Spin(\" <> ToString[2 n] <> \")\", _, t <> ToString[n]] <> \")\"];\nDGPanelSpectrumText[text_String] := Column[MapIndexed[\n  Style[If[First[#2] == 1, \"\", \"+ \"] <> #1, 11] &, StringSplit[text, \" + \"]], Spacings -> .2];\nDGPanelGroupChoices[nf_Integer] :=\n  ((#[[1]] <> ToString[#[[2]]]) -> DGPanelGroupLabel[#] &) /@\n    If[nf == 1, oneFactorGroups, twoFactorGroups];\nDGPanelDefaults[gauge_, nf_] := Switch[{gauge, nf},\n  {\"U1\", 1}, {\"G2\", \"D9\", 2}, {\"U1\", 2}, {\"A6\", \"D9\", 2},\n  {\"Sp1\", 1}, {\"C4\", \"D6\", 3}, {\"Sp1\", 2}, {\"A5\", \"D6\", 3}];\nDGPanelMaximumQ[gauge_, maximum_] := IntegerQ[maximum] &&\n  maximum >= If[gauge === \"U1\", 0, 1];\n\n(* Use the same engine as DGScan; keep all display inside the panels. *)\nDGPanelScan[gauge_, groups_List, maximum_] := Module[{gs},\n  If[! DGPanelReadyQ[] || ! MemberQ[{\"U1\", \"Sp1\"}, gauge] ||\n      ! DGPanelMaximumQ[gauge, maximum], Return[$Failed]];\n  gs = DGGroups[groups]; If[gs === $Failed, Return[$Failed]];\n  If[Length[gs] == 2 && ! AllTrue[gs, MemberQ[twoFactorGroups, #] &], Return[$Failed]];\n  CheckAbort[Check[If[Length[gs] == 1,\n    oneFactorScan[gauge, gs[[1, 1]], gs[[1, 2]], maximum],\n    twoFactorScan[gauge, gs[[1]], gs[[2]], maximum]], $Failed], $Aborted]];\n\nDGPanelSignData[spec_Association] := Module[{data, stored},\n  data = CheckAbort[Check[signAllocations[spec], $Failed], $Aborted];\n  If[! AssociationQ[data], Return[data]];\n  stored = Lookup[data, \"nsignStored\", data[\"nsign\"]];\n  If[data[\"nsign\"] =!= stored || Length[data[\"allocations\"]] =!= data[\"nsign\"],\n    Return[Failure[\"AllocationCountMismatch\", <|\"MessageTemplate\" ->\n      \"The enumerated allocation count differs from N_sign. The list is not certified complete.\",\n      \"Computed\" -> data[\"nsign\"], \"Stored\" -> stored|>]]];\n  data];\nDGPanelAllocationView[data_Association] := Column[{\n  Style[Row[{\"N_sign = \", data[\"nsign\"], \"  |  \", Length[data[\"allocations\"]],\n    \" complete allocation\", If[data[\"nsign\"] == 1, \"\", \"s\"]}], 13, Bold],\n  If[data[\"gauging\"] === \"U1\",\n    \"All compatible charge allocations are included; overall charge reversal counts once.\",\n    \"Sp(1) uses representation dimensions rather than signed charges. There are no independent charge signs (N_sign = 1).\"],\n  Grid[Prepend[MapIndexed[{First[#2],\n      DGPanelSpectrumText[#1[[2]]]} &, data[\"allocations\"]],\n    {Style[\"#\", Bold], Style[If[data[\"gauging\"] === \"U1\",\n      \"Complete charge allocation spectrum\", \"Complete Sp(1) spectrum\"], Bold]}],\n    Frame -> All, Alignment -> Left, Spacings -> {1, .8},\n    ItemSize -> {{3, 65}, Automatic}]\n}, Spacings -> 1, ItemSize -> {80, Automatic}];\n\nDGPanelSpectrumGrid[specs_List, indices_List, choose_, enabled_] := Module[{pair, u1, heads, rows},\n  If[specs === {} || indices === {}, Return[\"No spectra for this exact sector.\"]];\n  pair = KeyExistsQ[First[specs], \"b2\"]; u1 = First[specs][\"gauging\"] === \"U1\";\n  heads = Join[{\"Choose\", \"#\", \"Spectrum\"}, If[u1, {\"N_sign\"}, {}],\n    {\"b1\"}, If[pair, {\"b2\"}, {}], {\"bR+\", \"Lattice\"}];\n  rows = Table[With[{s = specs[[i]], index = i},\n    Join[{Button[\"Select\", choose[index], Method -> \"Queued\", ImageSize -> 58,\n      Enabled -> enabled], index,\n      DGPanelSpectrumText[spectrumString[s]]},\n      If[u1, {s[\"nsign\"]}, {}], {s[\"b1\"]}, If[pair, {s[\"b2\"]}, {}],\n      {s[\"bR\"], If[TrueQ[s[\"dagger\"]], \"I11\", \"U\"]}]], {i, indices}];\n  Grid[Prepend[rows, Style[#, Bold] & /@ heads], Frame -> All,\n    Alignment -> Left, Spacings -> {.8, .7},\n    ItemSize -> {Join[{6, 3, 35}, ConstantArray[Automatic, Length[heads] - 3]], Automatic}]];\n\nDGReaderPanel[] := DynamicModule[\n  {gauge = \"U1\", factors = 1, maximum = 2, group1 = \"G2\", group2 = \"D9\",\n   result = None, spectra = {}, selected = 0, allocations = None,\n   page = 1, pageSize = 20, busy = False, status = \"Choose the options, then click Find spectra.\",\n   reset, setDefaults, choose, rowOK, request, choices, pages, scanValue, signValue},\n  Column[{\n    Dynamic[If[DGPanelReadyQ[],\n      Style[\"Ready. Use the controls below; no code editing is needed.\", 12, RGBColor[.12, .38, .25]],\n      Style[\"Click Initialize notebook above to load the calculations for this kernel.\", 12, Darker[Red]]]],\n    Panel[Column[{\n      Style[\"1. Find spectra\", 20, Bold, RGBColor[.15, .25, .4]],\n      \"Choose the diagonal gauging and one or two additional simple group factors.\",\n      Grid[{\n        {Style[\"Diagonal gauging\", Bold], SetterBar[\n          Dynamic[gauge, (gauge = #; setDefaults[]; reset[]) &],\n          {\"U1\" -> \"U(1)\", \"Sp1\" -> \"Sp(1)\"}, Enabled -> Dynamic[! busy]]},\n        {Style[\"Additional group factors\", Bold], SetterBar[\n          Dynamic[factors, (factors = #; setDefaults[]; reset[]) &],\n          {1 -> \"One group\", 2 -> \"Two groups\"}, Enabled -> Dynamic[! busy]]},\n        {Style[\"Group 1\", Bold], Dynamic[PopupMenu[\n          Dynamic[group1, (group1 = #; reset[]) &], choices[],\n          Enabled -> Dynamic[! busy], ImageSize -> 235], TrackedSymbols :> {factors}]},\n        {Style[\"Group 2\", Bold], Dynamic[If[factors == 2,\n          PopupMenu[Dynamic[group2, (group2 = #; reset[]) &], choices[],\n            Enabled -> Dynamic[! busy], ImageSize -> 235],\n          Style[\"Not used for a one-group search.\", Gray]], TrackedSymbols :> {factors}]},\n        {Dynamic[Style[If[gauge === \"U1\", \"Exact largest charge q_max\", \"Exact largest dimension d_max\"], Bold]],\n          Row[{InputField[Dynamic[maximum, (maximum = #; reset[]) &], Number,\n            FieldSize -> 5, Enabled -> Dynamic[! busy]], Spacer[12],\n            Dynamic[If[DGPanelMaximumQ[gauge, maximum],\n              Style[If[gauge === \"U1\", \"Integer 0 or larger\", \"Integer 1 or larger\"], Gray],\n              Style[\"Enter a valid integer.\", Darker[Red]]]]}]}\n      }, Alignment -> Left, Spacings -> {2, 1}],\n      Dynamic[If[gauge === \"U1\",\n        \"Exact means max |q| equals q_max. Lower charges may also occur; q_max = 0 selects the neutral sector.\",\n        \"Exact means the largest Sp(1) representation dimension equals d_max. Lower dimensions may also occur; d_max = 1 selects the trivial diagonal representation.\"]],\n      Row[{Button[Style[\"Find spectra\", Bold],\n          busy = True; status = \"Searching. Larger groups and maxima may take time.\";\n          result = None; spectra = {}; selected = 0; allocations = None; page = 1;\n          request = {gauge, If[factors == 1, {group1}, {group1, group2}], maximum};\n          scanValue = DGPanelScan @@ request;\n          If[AssociationQ[scanValue], result = scanValue; spectra = result[\"spectra\"];\n            status = If[spectra === {}, \"No spectra for this exact sector. Try different options.\",\n              \"Search complete. Select a spectrum below to explore its allocations.\"],\n            status = If[scanValue === $Aborted, \"Search stopped. Click Find spectra to try again.\",\n              \"Search did not finish successfully. Check the options and the kernel messages.\"]];\n          busy = False,\n          Method -> \"Queued\", ImageSize -> {160, 34},\n          Enabled -> Dynamic[! busy && DGPanelReadyQ[] && DGPanelMaximumQ[gauge, maximum]]],\n        Spacer[15], Dynamic[If[busy, ProgressIndicator[Appearance -> \"Percolate\"], \"\"]]}],\n      Dynamic[Style[status, 12]],\n      Dynamic[If[AssociationQ[result], Column[{\n        Style[Row[{\"Results for \", If[result[\"gauging\"] === \"U1\", \"U(1)\", \"Sp(1)\"], \" + \",\n          Lookup[result, \"group\", Lookup[result, \"groups\", \"\"]], \"   |   exact \",\n          If[result[\"gauging\"] === \"U1\", \"q_max\", \"d_max\"], \" = \", result[\"maxLabel\"]}], 13, Bold],\n        DGSummary[result],\n        If[spectra === {}, Nothing, Column[{\n          Row[{Button[\"Previous page\", page--, Enabled -> Dynamic[! busy && page > 1]], Spacer[10],\n            Dynamic[Row[{\"Page \", page, \" of \", pages[], \"  (20 spectra per page)\"}]], Spacer[10],\n            Button[\"Next page\", page++, Enabled -> Dynamic[! busy && page < pages[]]]}],\n          Pane[DGPanelSpectrumGrid[spectra,\n            Range[(page - 1) pageSize + 1, Min[page pageSize, Length[spectra]]], choose, Dynamic[! busy]],\n            {940, UpTo[360]}, Scrollbars -> {True, True}],\n          \"Select opens the spectrum in panel 2. Row numbers stay the same across pages.\"\n        }, Spacings -> 1]]\n      }, Spacings -> 1.2], \"\"], TrackedSymbols :> {result, page, busy}]\n    }, Spacings -> 1.2, ItemSize -> {80, Automatic}], Background -> RGBColor[.97, .98, 1], FrameMargins -> 18],\n\n    Panel[Column[{\n      Style[\"2. Explore one spectrum\", 20, Bold, RGBColor[.15, .25, .4]],\n      \"Select a row in panel 1, or enter its spectrum number here.\",\n      Row[{Style[\"Spectrum number\", Bold], Spacer[10],\n        InputField[Dynamic[selected, (choose[#]) &], Number, FieldSize -> 6,\n      Enabled -> Dynamic[! busy && DGPanelReadyQ[] && Length[spectra] > 0]], Spacer[12],\n        Dynamic[If[spectra === {}, \"Run a search first.\", Row[{\"Available: 1 to \", Length[spectra]}]]]}],\n      Dynamic[If[rowOK[], Column[{\n        Style[Row[{\"Selected spectrum #\", selected}], 13, Bold],\n        Pane[DGTable[{spectra[[selected]]}], {940, UpTo[170]}, Scrollbars -> {True, True}],\n        If[spectra[[selected]][\"gauging\"] === \"U1\",\n          Row[{\"This spectrum has N_sign = \", spectra[[selected]][\"nsign\"], \" possible charge allocations.\"}],\n          \"Sp(1) has no independent signed-charge choices. Its dimension allocation is shown below.\"]\n      }, Spacings -> 1], If[spectra === {}, \"\", \"Choose a spectrum number within the available range.\"]],\n        TrackedSymbols :> {selected, spectra}],\n      Button[Dynamic[If[gauge === \"U1\", \"Show all charge allocations\", \"Show complete dimension allocation\"]],\n        busy = True; allocations = None; status = \"Enumerating every allocation of the selected spectrum.\";\n        signValue = DGPanelSignData[spectra[[selected]]];\n        allocations = signValue;\n        status = Which[AssociationQ[allocations], \"All allocations computed.\",\n          allocations === $Aborted, \"Allocation enumeration stopped. Click the button to try again.\",\n          True, \"Allocation enumeration did not finish successfully.\"];\n        busy = False,\n        Method -> \"Queued\", ImageSize -> {285, 34}, Enabled -> Dynamic[! busy && DGPanelReadyQ[] && rowOK[]]],\n      Dynamic[Which[\n        AssociationQ[allocations], Column[{\n          Pane[DGPanelAllocationView[allocations], {940, UpTo[360]}, Scrollbars -> {True, True}],\n          Button[\"Open complete list in a new notebook\",\n            CreateDocument[{\n              Cell[\"Allocations for spectrum #\" <> ToString[selected], \"Title\"],\n              Cell[BoxData[ToBoxes[DGTable[{spectra[[selected]]}], StandardForm]], \"Output\"],\n              Cell[BoxData[ToBoxes[DGPanelAllocationView[allocations], StandardForm]], \"Output\"]},\n              WindowTitle -> \"DG_search: complete spectrum allocations\"], Method -> \"Queued\", ImageSize -> {330, 30}],\n          If[allocations[\"gauging\"] === \"U1\", OpenerView[{\"Sign differences (advanced)\",\n            Grid[Prepend[MapIndexed[{First[#2], #1[[1]]} &, allocations[\"allocations\"]],\n              {\"#\", \"s_j = N_+j - N_-j, per complex charged block\"}], Frame -> All, Alignment -> Left]}], Nothing]\n        }, Spacings -> 1],\n        FailureQ[allocations], Style[Row[{allocations[\"MessageTemplate\"], \" Computed: \",\n          allocations[\"Computed\"], \"; stored: \", allocations[\"Stored\"], \".\"}], Darker[Red]],\n        allocations === $Aborted, \"No partial list is displayed. Enumeration was stopped.\",\n        allocations === $Failed, \"No allocation list is available. Check the kernel messages and try again.\",\n        True, \"\"], TrackedSymbols :> {allocations}],\n      Dynamic[If[gauge === \"U1\",\n        \"Charge tuples list counts in the order (+Q, ..., +1, 0, -1, ..., -Q), with Q = max(1, q_max).\\nOverall reversal counts once; self-conjugate blocks have no independent sign choice.\",\n        \"Sp(1) terms m(R,d) give multiplicity m, additional-group representation R, and diagonal Sp(1) dimension d.\"]]\n    }, Spacings -> 1.2, ItemSize -> {80, Automatic}], Background -> RGBColor[.98, .98, .98], FrameMargins -> 18],\n\n    OpenerView[{\"Notation and search scope\", Column[{\n      \"A spectrum fixes the matter content and absolute charges (U(1)) or diagonal representation dimensions (Sp(1)). A class groups spectra with equivalent anomaly vectors.\",\n      \"b1 and b2 are additional-factor anomaly vectors; bR+ is the diagonal vector. U admits an even lattice; I11 requires the odd lattice. The U(1) lattice test uses bR+/2.\",\n      \"The catalogue assumes n_T = 1, n_H = n_V + 244, and no hypermultiplet trivial under all additional factors. One-group scope: ranks 3-30 plus G2. Two-group scope: ranks 5-30 plus F4.\",\n      \"Menus use Cartan type and rank: A5 = SU(6), C4 = Sp(4), D6 = Spin(12). Only the additional group factors are selected here.\",\n      \"Searches and allocation enumeration are exhaustive. Large choices may take time; changing an option clears the previous results. Technical routines remain available below.\"\n    }, Spacings -> 1, ItemSize -> {80, Automatic}]}]\n  }, Spacings -> 1.5],\n  Initialization :> (\n    reset[] := (result = None; spectra = {}; selected = 0; allocations = None; page = 1;\n      status = \"Choices changed. Click Find spectra to generate matching results.\");\n    setDefaults[] := ({group1, group2, maximum} = DGPanelDefaults[gauge, factors]);\n    choices[] := DGPanelGroupChoices[factors];\n    pages[] := Max[1, Ceiling[Length[spectra]/pageSize]];\n    rowOK[] := IntegerQ[selected] && 1 <= selected <= Length[spectra];\n    choose[i_] := If[! busy, selected = i; allocations = None;\n      If[rowOK[], page = Ceiling[selected/pageSize]]]\n  ),\n  UnsavedVariables :> {result, spectra, selected, allocations, busy, page, status, request, scanValue, signValue},\n  BaseStyle -> {FontFamily -> \"Helvetica\", FontSize -> 12}\n];\n"],"Input",InitializationCell->True,CellTags->"DGPanelDefinitions"]},Closed]],
Cell[CellGroupData[{Cell["Optional command-line use inside Mathematica","Section"],
Cell["The original helpers remain available for advanced use. Evaluate these examples only when needed; the panels provide the same search and sign-enumeration calculations.","Text"],
Cell["DGScan returns the exact largest-label sector. DGTable shows its spectra. DGSigns[result,i] lists the complete charge allocations of spectrum i.","Text"],
Cell[BoxData["example = DGScan[\"U1\", {\"A6\", \"D9\"}, 2];\nDGTable[example]"],"Input"],
Cell[BoxData["DGSigns[example, 8]"],"Input"],
Cell["Expected for the U(1) example: 8 spectra, 6 classes, sum N_sign = 37; spectrum 8 has 14 charge allocations. Sp(1) examples: C4 at exact d_max = 3 has 3 spectra in 3 classes; A5 x D6 has 5 spectra in 5 classes.","Text"],
Cell[BoxData["spExample = DGScan[\"Sp1\", {\"C4\"}, 3];\nDGTable[spExample]"],"Input"],
Cell["Other original APIs include DGSummary, DGFind, DGNames, DGCheckU1, DGCheckSp1, DGSignsU1, compareOneFactor and compareTwoFactor. The long-scan switches still initialize to False.","Text"]},Closed]]
},
 WindowTitle->"DG_search - spectrum explorer",
 WindowSize->{1200,850},
 StyleDefinitions->"Default.nb",
 InitializationCellEvaluation->False,
 TaggingRules->{"Edition"->"Reader panels v3", "SourceNotebookSHA256"->"bfc9d3cee67c194d59012a38b49de0d8cd15c4d4f249cfe8f3302fec42385c87"}
]
