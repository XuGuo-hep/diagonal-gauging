                 RowBox[{
                  RowBox[{"t", "[", "\"\<r\>\"", "]"}], " ", "<=", " ", 
                  RowBox[{"t", "[", "\"\<s\>\"", "]"}]}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"t", "[", "\"\<r\>\"", "]"}], ",", " ", 
                    RowBox[{"t", "[", "\"\<s\>\"", "]"}]}], "}"}], "}"}], ",",
                  " ", 
                 RowBox[{"{", "}"}]}], "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"t", "[", "\"\<r\>\"", "]"}], ",", " ", 
                  RowBox[{"t", "[", "\"\<s\>\"", "]"}]}], "}"}], "}"}]}], 
              "]"}]}], ";", "\n", "     ", 
            RowBox[{"Do", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"At", " ", "=", " ", 
                RowBox[{"adjA", " ", "+", " ", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"u", " ", 
                    RowBox[{"rs", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], " ", "+", " ", 
                    RowBox[{"v", " ", 
                    RowBox[{"rs", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}]}], ")"}], "/", 
                  "lam"}]}]}], ";", "\n", "      ", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"!", " ", 
                  RowBox[{"IntegerQ", "[", 
                   RowBox[{"L", " ", "At"}], "]"}]}], ",", " ", 
                 RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\n", "      ", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"!", " ", 
                   RowBox[{
                    RowBox[{"latticeTest", "[", 
                    RowBox[{"latticeVectors", "[", 
                    RowBox[{"\"\<U1\>\"", ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"{", 
                    RowBox[{"u", ",", " ", "v"}], "}"}], "}"}], ",", " ", 
                    "rs"}], "]"}], "]"}], "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], " ", "||", " ", 
                  RowBox[{"!", " ", 
                   RowBox[{"kineticOK", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"u", ",", " ", "v"}], "}"}], ",", " ", "rs"}], 
                    "}"}], "]"}]}]}], ",", " ", 
                 RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\n", "      ", 
               RowBox[{"key", " ", "=", " ", 
