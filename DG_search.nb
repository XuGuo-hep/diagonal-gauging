     "\"\<DGCheckSp1[{\\\"A5\\\"}, blocks] checks Sp(1) table blocks {rep, d, \
m}, where d is a positive integer representation dimension and m is a \
positive exact integer or half-integer in full-hypermultiplet units. For two \
groups use a pair of representation strings.\>\""}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"DGCheckSp1", "[", 
      RowBox[{"groups_List", ",", " ", "blocks_List"}], "]"}], " ", ":=", 
     "\n", " ", 
     RowBox[{"Catch", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"gs", ",", " ", "nf", ",", " ", 
           RowBox[{"converted", " ", "=", " ", 
            RowBox[{"{", "}"}]}], ",", " ", "block", ",", " ", "rep", ",", 
           " ", "d", ",", " ", "m"}], "}"}], ",", "\n", "  ", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"!", " ", 
             RowBox[{"DGTableReadyQ", "[", "]"}]}], ",", " ", 
            RowBox[{"DGTableStop", "[", 
