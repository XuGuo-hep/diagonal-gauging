          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"gs", " ", "===", " ", "$Failed"}], ",", " ", 
            RowBox[{"DGTableStop", "[", "$Failed", "]"}]}], "]"}], ";", "\n", 
          "  ", 
          RowBox[{"nf", " ", "=", " ", 
           RowBox[{"Length", "[", "gs", "]"}]}], ";", "\n", "  ", 
          RowBox[{"If", "[", 
           RowBox[{
