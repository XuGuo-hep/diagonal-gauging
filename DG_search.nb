       RowBox[{"First", "[", "sols", "]"}], "[", "\"\<gauging\>\"", "]"}], 
      "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"oneFactorRow", "[", "sol_", "]"}], " ", ":=", " ", 
