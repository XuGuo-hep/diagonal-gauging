               "}"}]}], "}"}]}], "]"}], "\n", "   ", 
          RowBox[{"DGCheckSp1", "[", 
           RowBox[{
            RowBox[{"{", "\"\<A5\>\"", "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"\"\<6\>\"", ",", " ", "1", ",", " ", "11"}], "}"}], 
              ",", " ", 
              RowBox[{"{", 
               RowBox[{"\"\<6\>\"", ",", " ", "3", ",", " ", "3"}], "}"}], 
              ",", "\n", "     ", 
              RowBox[{"{", 
               RowBox[{"\"\<20\>\"", ",", " ", "1", ",", " ", 
                RowBox[{"4", "/", "2"}]}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"\"\<20\>\"", ",", " ", "2", ",", " ", "2"}], "}"}], 
              ",", " ", 
              RowBox[{"{", 
               RowBox[{"\"\<21\>\"", ",", " ", "2", ",", " ", "1"}], "}"}]}], 
             "}"}]}], "]"}], "\n", "   ", "Integer", " ", 
          "multiplicities"}]}]}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"including", " ", 
       RowBox[{"4", "/", "2"}]}], " ", "=", " ", "2"}], ",", " ", 
     RowBox[{
      RowBox[{"use", " ", "full", " ", "hypermultiplets"}], ";", "\n", "   ", 
      
      RowBox[{
      "their", " ", "anomaly", " ", "sums", " ", "equal", " ", "the", " ", 
       "corresponding", " ", "even", " ", "number", " ", "of", " ", "allowed",
        " ", 
       RowBox[{"halves", ".", "\n", "   ", "Try"}], " ", 
       RowBox[{"{", 
        RowBox[{"\"\<20\>\"", ",", " ", "1", ",", " ", 
         RowBox[{"3", "/", "2"}]}], "}"}], " ", "to", " ", "exercise", " ", 
       "conversion", " ", "of", " ", "an", " ", "odd", " ", "number", " ", 
       "of", " ", 
       RowBox[{"halves", "."}]}]}]}], "\n", "*)"}], "\n", "\n", 
   RowBox[{
    RowBox[{"$DGReady", " ", "=", " ", "True"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", 
     "\"\<DG_search ready. Evaluate a quick example with Shift+Enter.\>\"", 
