   NotebookFind[nb, "DGReaderWorkspace", All, CellTags];
   NotebookWrite[nb, Cell[BoxData[ToBoxes[DGReaderPanel[], StandardForm]],
     "Output", CellTags -> "DGReaderWorkspace", CellLabel -> "", ShowCellLabel -> False]];
   NotebookFind[nb, "DGReaderWorkspace", All, CellTags];
   SelectionMove[nb, Before, Cell],
   MessageDialog["Initialization did not finish. Check Mathematica's kernel messages, then click Initialize notebook again."]]
