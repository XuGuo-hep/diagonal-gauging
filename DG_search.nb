                 RowBox[{"Length", "[", "block", "]"}], " ", "!=", " ", 
                 "3"}]}], ",", "\n", "    ", 
               RowBox[{"DGTableStop", "[", 
                RowBox[{"DGTableFailure", "[", 
                 RowBox[{"\"\<DGCheckSp1\>\"", ",", " ", 
                  RowBox[{"\"\<Block \>\"", " ", "<>", " ", 
                   RowBox[{"ToString", "[", "j", "]"}], " ", "<>", "\n", 
                   "      ", "\"\< must be {rep, d, m}.\>\""}]}], "]"}], 
                "]"}]}], "]"}], ";", "\n", "   ", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"rep", ",", " ", "d", ",", " ", "m"}], "}"}], " ", "=",
               " ", "block"}], ";", "\n", "   ", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"!", " ", 
                RowBox[{"DGTableRepShapeQ", "[", 
                 RowBox[{"rep", ",", " ", "nf"}], "]"}]}], ",", " ", 
               RowBox[{"DGTableStop", "[", 
                RowBox[{"DGTableFailure", "[", 
                 RowBox[{"\"\<DGCheckSp1\>\"", ",", "\n", "     ", 
                  RowBox[{"\"\<Block \>\"", " ", "<>", " ", 
                   RowBox[{"ToString", "[", "j", "]"}], " ", "<>", " ", 
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"nf", " ", "==", " ", "1"}], ",", "\n", 
                    "       ", 
                    "\"\< needs one representation string, for example \
\\\"6\\\".\>\"", ",", "\n", "       ", 
                    "\"\< needs two representation strings, for example \
{\\\"6\\\", \\\"1\\\"}.\>\""}], "]"}]}]}], "]"}], "]"}]}], "]"}], ";", "\n", 
             "   ", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"!", " ", 
                 RowBox[{"IntegerQ", "[", "d", "]"}]}], " ", "||", " ", 
                RowBox[{"d", " ", "<", " ", "1"}]}], ",", " ", 
               RowBox[{"DGTableStop", "[", 
                RowBox[{"DGTableFailure", "[", 
                 RowBox[{"\"\<DGCheckSp1\>\"", ",", "\n", "     ", 
                  RowBox[{"\"\<Block \>\"", " ", "<>", " ", 
                   RowBox[{"ToString", "[", "j", "]"}], " ", "<>", " ", 
                   "\"\< needs a positive integer dimension d.\>\""}]}], 
                 "]"}], "]"}]}], "]"}], ";", "\n", "   ", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"!", " ", 
                 RowBox[{"IntegerQ", "[", 
                  RowBox[{"2", " ", "m"}], "]"}]}], " ", "||", " ", 
                RowBox[{"!", " ", 
                 RowBox[{"TrueQ", "[", 
                  RowBox[{"m", " ", ">", " ", "0"}], "]"}]}]}], ",", "\n", 
               "    ", 
               RowBox[{"DGTableStop", "[", 
                RowBox[{"DGTableFailure", "[", 
                 RowBox[{"\"\<DGCheckSp1\>\"", ",", " ", 
                  RowBox[{"\"\<Block \>\"", " ", "<>", " ", 
                   RowBox[{"ToString", "[", "j", "]"}], " ", "<>", "\n", 
                   "      ", 
                   "\"\< needs a positive exact integer or half-integer \
multiplicity m (use 1/2, not 0.5).\>\""}]}], "]"}], "]"}]}], "]"}], ";", "\n",
              "   ", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"converted", ",", " ", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"IntegerQ", "[", "m", "]"}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"rep", ",", " ", 
                   RowBox[{"ConstantArray", "[", 
                    RowBox[{"d", ",", " ", "m"}], "]"}]}], "}"}], ",", "\n", 
                 "     ", 
                 RowBox[{"{", 
                  RowBox[{"rep", ",", " ", "\"\<half\>\"", ",", " ", 
                   RowBox[{"ConstantArray", "[", 
                    RowBox[{"d", ",", " ", 
                    RowBox[{"2", " ", "m"}]}], "]"}]}], "}"}]}], "]"}]}], 
              "]"}]}], ",", "\n", "   ", 
            RowBox[{"{", 
             RowBox[{"j", ",", " ", 
              RowBox[{"Length", "[", "blocks", "]"}]}], "}"}]}], "]"}], ";", 
          "\n", "  ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"!", " ", 
             RowBox[{"DGTableNamesOKQ", "[", 
              RowBox[{"\"\<Sp1\>\"", ",", " ", "gs", ",", " ", 
               RowBox[{"First", " ", "/@", " ", "blocks"}], ",", " ", 
               "\"\<DGCheckSp1\>\""}], "]"}]}], ",", "\n", "   ", 
            RowBox[{"DGTableStop", "[", "$Failed", "]"}]}], "]"}], ";", "\n", 
          "  ", 
          RowBox[{"checkSpectrum", "[", 
           RowBox[{"\"\<Sp1\>\"", ",", " ", "gs", ",", " ", "converted"}], 
           "]"}]}]}], "\n", " ", "]"}], ",", " ", "DGTableInputFailureTag"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"DGCheckSp1", "[", "___", "]"}], " ", ":=", " ", 
     RowBox[{"DGTableFailure", "[", 
      RowBox[{
      "\"\<DGCheckSp1\>\"", ",", "\n", "  ", 
       "\"\<Use DGCheckSp1[groups, blocks], with both arguments lists.\>\""}],
       "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Existing", " ", "A5", " ", "examples"}], ",", " ", 
     RowBox[{
      RowBox[{"expressed", " ", "directly", " ", "in", " ", "table", " ", 
       RowBox[{"notation", ":", "\n", "   ", 
        RowBox[{"First", " ", "q"}]}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"2", " ", "table", " ", "row", " ", 
         RowBox[{"(", 
          RowBox[{
          "the", " ", "two", " ", "20", " ", "blocks", " ", "may", " ", 
           "also", " ", "be", " ", "combined"}], ")"}]}], ":", "\n", "   ", 
        RowBox[{
         RowBox[{"DGCheckU1", "[", 
          RowBox[{
           RowBox[{"{", "\"\<A5\>\"", "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"\"\<6\>\"", ",", " ", 
               RowBox[{"{", 
                RowBox[{
                "2", ",", " ", "10", ",", " ", "4", ",", " ", "2", ",", " ", 
                 "0"}], "}"}]}], "}"}], ",", "\n", "     ", 
             RowBox[{"{", 
              RowBox[{"\"\<15\>\"", ",", " ", 
               RowBox[{"{", 
                RowBox[{
                "0", ",", " ", "0", ",", " ", "1", ",", " ", "1", ",", " ", 
                 "0"}], "}"}]}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"\"\<20\>\"", ",", " ", 
               RowBox[{"{", 
                RowBox[{
                "1", ",", " ", "1", ",", " ", "0", ",", " ", "0", ",", " ", 
                 "0"}], "}"}]}], "}"}], ",", "\n", "     ", 
             RowBox[{"{", 
              RowBox[{"\"\<20\>\"", ",", " ", 
               RowBox[{"{", 
                RowBox[{
                "0", ",", " ", "0", ",", " ", "3", ",", " ", "0", ",", " ", 
                 "0"}], "}"}]}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"\"\<21\>\"", ",", " ", 
               RowBox[{"{", 
                RowBox[{
                "0", ",", " ", "0", ",", " ", "1", ",", " ", "1", ",", " ", 
                 "0"}], "}"}]}], "}"}]}], "}"}]}], "]"}], "\n", "   ", 
         "First", " ", "q"}]}], " ", "=", " ", 
       RowBox[{"1", " ", "table", " ", 
        RowBox[{"row", ":", "\n", "   ", 
         RowBox[{
          RowBox[{"DGCheckU1", "[", 
           RowBox[{
            RowBox[{"{", "\"\<A5\>\"", "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"\"\<6\>\"", ",", " ", 
                RowBox[{"{", 
                 RowBox[{"7", ",", " ", "8", ",", " ", "3"}], "}"}]}], "}"}], 
              ",", " ", 
              RowBox[{"{", 
               RowBox[{"\"\<15\>\"", ",", " ", 
                RowBox[{"{", 
                 RowBox[{"0", ",", " ", "0", ",", " ", "2"}], "}"}]}], "}"}], 
              ",", "\n", "     ", 
              RowBox[{"{", 
               RowBox[{"\"\<20\>\"", ",", " ", 
                RowBox[{"{", 
                 RowBox[{"5", ",", " ", "0", ",", " ", "0"}], "}"}]}], "}"}], 
              ",", " ", 
              RowBox[{"{", 
               RowBox[{"\"\<21\>\"", ",", " ", 
                RowBox[{"{", 
