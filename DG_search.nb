             RowBox[{"K1", " ", "S4"}]}]}], " ", "->", " ", 
           RowBox[{"list", " ", "of", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"L", " ", "A_target"}], ",", " ", "r", ",", " ", "s"}], 
             "}"}]}]}], " ", "*)"}], "\n", "    ", 
         RowBox[{"targets", " ", "=", " ", 
          RowBox[{"<|", "|>"}]}], ";", "\n", "    ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"orders", " ", "=", " ", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"t", "[", "\"\<r\>\"", "]"}], " ", "==", " ", 
                 RowBox[{"t", "[", "\"\<s\>\"", "]"}]}], " ", "||", " ", 
                RowBox[{"u", " ", "==", " ", "v"}]}], ",", " ", 
               RowBox[{"If", "[", 
